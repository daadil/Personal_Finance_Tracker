# ALL personal financial data lives under private_data/ and nothing in it is ever committed:
#   inbox/        raw bank exports (the actuals)
#   master/       the merged master, backups, reports (the actuals, and outputs)
#   reference/    the old 2023 script, merchant lists, Mapping.xlsx, workflow diagram (training data)
#   rules/        category rules built from the reference files
#   review/       files David edits by hand
#   test_output/  anything a test or dry run writes
/private_data/

# Second layer, in case a data file ends up somewhere else by mistake.
*.csv
*.xlsx
*.xls
*.qfx
*.ofx
*.pdf
*.bak

# Python and the editor
/venv/
.venv/
__pycache__/
.DS_Store
